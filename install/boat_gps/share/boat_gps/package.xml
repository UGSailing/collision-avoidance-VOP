<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>boat_gps</name>
  <version>1.0.0</version>
  <description>gps bridge and ntrip client for FLEPOS corrections</description>
  <maintainer email="jasper.vandevelde@ugent.be">Jasper Van de Velde</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>ntrip-client</exec_depend>
  <exec_depend>nmea-navsat-driver</exec_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
